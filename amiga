#!/usr/bin/env bash
# AMIGA CLI — one command to rule them all
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$SCRIPT_DIR/venv"
DB_PATH="$SCRIPT_DIR/data/agentlab.db"
LOG_PATH="$SCRIPT_DIR/logs/monitoring.log"
ENV_FILE="$SCRIPT_DIR/.env"
ENV_EXAMPLE="$SCRIPT_DIR/.env.example"
PORT=3000
PLIST_LABEL="com.amiga.server"
PLIST_PATH="$HOME/Library/LaunchAgents/${PLIST_LABEL}.plist"

# ---------------------------------------------------------------------------
# Colors (graceful degradation if tput unavailable)
# ---------------------------------------------------------------------------
if command -v tput >/dev/null 2>&1 && [ -t 1 ]; then
    BOLD=$(tput bold)
    DIM=$(tput dim)
    GREEN=$(tput setaf 2)
    YELLOW=$(tput setaf 3)
    RED=$(tput setaf 1)
    CYAN=$(tput setaf 6)
    RESET=$(tput sgr0)
else
    BOLD="" DIM="" GREEN="" YELLOW="" RED="" CYAN="" RESET=""
fi

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
info()  { echo "${GREEN}>>>${RESET} $*"; }
warn()  { echo "${YELLOW}!!${RESET} $*"; }
err()   { echo "${RED}ERROR:${RESET} $*" >&2; }
step()  { echo ""; echo "${BOLD}${CYAN}--- $* ---${RESET}"; }
dim()   { echo "${DIM}    $*${RESET}"; }

server_pid() {
    lsof -ti:$PORT 2>/dev/null || true
}

is_running() {
    [ -n "$(server_pid)" ]
}

daemon_installed() {
    [ -f "$PLIST_PATH" ]
}

daemon_loaded() {
    launchctl list "$PLIST_LABEL" >/dev/null 2>&1
}

require_macos() {
    if [ "$(uname)" != "Darwin" ]; then
        err "Daemon install is macOS-only. Use systemd manually."
        exit 1
    fi
}

activate_venv() {
    if [ ! -d "$VENV_DIR" ]; then
        err "No venv found. Run './amiga setup' first."
        exit 1
    fi
    # shellcheck disable=SC1091
    source "$VENV_DIR/bin/activate"
    export PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}"
}

require_db() {
    if [ ! -f "$DB_PATH" ]; then
        err "Database not found at $DB_PATH"
        dim "Start the server first: ./amiga start"
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_setup() {
    local install_daemon=false
    for arg in "$@"; do
        case "$arg" in
            --install-daemon) install_daemon=true ;;
        esac
    done

    echo ""
    echo "${BOLD}AMIGA Setup${RESET}"
    echo "==========="
    echo ""

    # --- Python version ---
    step "Checking Python"
    if ! command -v python3 >/dev/null 2>&1; then
        err "python3 not found. Install Python 3.12+ and try again."
        exit 1
    fi
    PY_VERSION=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
    PY_MAJOR=$(echo "$PY_VERSION" | cut -d. -f1)
    PY_MINOR=$(echo "$PY_VERSION" | cut -d. -f2)
    if [ "$PY_MAJOR" -lt 3 ] || { [ "$PY_MAJOR" -eq 3 ] && [ "$PY_MINOR" -lt 12 ]; }; then
        err "Python 3.12+ required (found $PY_VERSION)"
        exit 1
    fi
    info "Python $PY_VERSION"

    # --- Node.js version ---
    step "Checking Node.js"
    if command -v node >/dev/null 2>&1; then
        NODE_VERSION=$(node --version | sed 's/^v//')
        NODE_MAJOR=$(echo "$NODE_VERSION" | cut -d. -f1)
        if [ "$NODE_MAJOR" -lt 18 ]; then
            warn "Node 18+ required for frontend build (found $NODE_VERSION)."
            dim "Install from https://nodejs.org/"
        else
            info "Node $NODE_VERSION"
        fi
    else
        warn "Node 18+ required for frontend build. Install from https://nodejs.org/"
        dim "Setup will continue, but frontend build may fail."
    fi

    # --- jq ---
    if ! command -v jq >/dev/null 2>&1; then
        warn "jq not found. Some features (hooks, CLI operations) need it."
        dim "Install with: brew install jq"
    fi

    # --- Virtual environment ---
    step "Virtual environment"
    if [ -d "$VENV_DIR" ]; then
        info "Already exists at venv/"
    else
        info "Creating venv..."
        python3 -m venv "$VENV_DIR"
        info "Created"
    fi
    # shellcheck disable=SC1091
    source "$VENV_DIR/bin/activate"

    # --- Dependencies ---
    step "Installing dependencies"
    pip install --upgrade pip --quiet
    pip install -r "$SCRIPT_DIR/requirements.txt" --quiet
    info "All packages installed"

    # --- Pre-commit ---
    step "Pre-commit hooks"
    if ! command -v pre-commit >/dev/null 2>&1; then
        pip install pre-commit --quiet || true
    fi
    if (cd "$SCRIPT_DIR" && pre-commit install >/dev/null 2>&1); then
        info "Hooks installed"
    else
        warn "Could not install pre-commit hooks (non-fatal)"
    fi

    # --- Environment file ---
    step "Environment configuration"
    if [ -f "$ENV_FILE" ]; then
        info ".env already exists"
        # Check if key variables are set
        if grep -q "^ANTHROPIC_API_KEY=your_anthropic_api_key_here" "$ENV_FILE" 2>/dev/null || \
           grep -q "^ANTHROPIC_API_KEY=$" "$ENV_FILE" 2>/dev/null; then
            warn "ANTHROPIC_API_KEY is not configured in .env"
            configure_env_interactive
        else
            dim "To reconfigure, edit .env directly"
        fi
    else
        if [ -f "$ENV_EXAMPLE" ]; then
            cp "$ENV_EXAMPLE" "$ENV_FILE"
            info "Created .env from .env.example"
        else
            touch "$ENV_FILE"
            info "Created empty .env"
        fi
        configure_env_interactive
    fi

    # --- Data and log directories ---
    mkdir -p "$SCRIPT_DIR/data" "$SCRIPT_DIR/logs" "$SCRIPT_DIR/static/chat"

    # --- Build frontend ---
    step "Building chat frontend"
    if [ -f "$SCRIPT_DIR/deploy.sh" ]; then
        info "Running deploy.sh chat..."
        (cd "$SCRIPT_DIR" && bash deploy.sh chat)
    else
        warn "deploy.sh not found. Skipping frontend build."
        dim "You can build manually later."
    fi

    # --- Daemon (optional) ---
    if [ "$install_daemon" = true ]; then
        step "Installing daemon"
        cmd_install_daemon
    elif [[ "$(uname)" == "Darwin" ]]; then
        echo ""
        echo -n "Install as login daemon (auto-start on boot)? [Y/n]: "
        read -r install_choice
        if [[ ! "$install_choice" =~ ^[Nn] ]]; then
            step "Installing daemon"
            cmd_install_daemon
        fi
    fi

    # --- Done ---
    echo ""
    echo "${BOLD}${GREEN}Setup complete.${RESET}"
    echo ""
    echo "  Chat UI:    ${CYAN}http://localhost:$PORT${RESET}"
    echo "  Dashboard:  ${CYAN}http://localhost:$PORT/dashboard${RESET}"
    echo ""
    echo "  ${DIM}amiga start     Start the server${RESET}"
    echo "  ${DIM}amiga stop      Stop the server${RESET}"
    echo "  ${DIM}amiga status    Check what's running${RESET}"
    echo "  ${DIM}amiga doctor    System health check${RESET}"
    echo "  ${DIM}amiga help      All commands${RESET}"
    echo ""
}

configure_env_interactive() {
    echo ""

    # ANTHROPIC_API_KEY
    echo -n "${BOLD}Anthropic API key${RESET} (sk-ant-...): "
    read -r api_key
    if [ -z "$api_key" ]; then
        err "API key cannot be empty. Set it later in .env"
    else
        if grep -q "^ANTHROPIC_API_KEY=" "$ENV_FILE" 2>/dev/null; then
            sed -i.bak "s|^ANTHROPIC_API_KEY=.*|ANTHROPIC_API_KEY=$api_key|" "$ENV_FILE"
            rm -f "$ENV_FILE.bak"
        else
            echo "ANTHROPIC_API_KEY=$api_key" >> "$ENV_FILE"
        fi
        info "API key saved"
    fi

    # WORKSPACE_PATH
    default_workspace="$HOME/Workspace"
    echo -n "${BOLD}Workspace path${RESET} [$default_workspace]: "
    read -r workspace
    workspace="${workspace:-$default_workspace}"
    if grep -q "^WORKSPACE_PATH=" "$ENV_FILE" 2>/dev/null; then
        sed -i.bak "s|^WORKSPACE_PATH=.*|WORKSPACE_PATH=$workspace|" "$ENV_FILE"
        rm -f "$ENV_FILE.bak"
    else
        echo "WORKSPACE_PATH=$workspace" >> "$ENV_FILE"
    fi
    info "Workspace: $workspace"

    # Cost limits (optional)
    echo ""
    echo -n "Set cost limits? [y/N]: "
    read -r set_limits
    if [[ "$set_limits" =~ ^[Yy] ]]; then
        echo -n "  Daily limit USD [100]: "
        read -r daily
        daily="${daily:-100}"
        sed -i.bak "s|^DAILY_COST_LIMIT=.*|DAILY_COST_LIMIT=$daily|" "$ENV_FILE"
        rm -f "$ENV_FILE.bak"

        echo -n "  Monthly limit USD [1000]: "
        read -r monthly
        monthly="${monthly:-1000}"
        sed -i.bak "s|^MONTHLY_COST_LIMIT=.*|MONTHLY_COST_LIMIT=$monthly|" "$ENV_FILE"
        rm -f "$ENV_FILE.bak"

        info "Limits set: \$$daily/day, \$$monthly/month"
    fi

    # Secure .env (readable only by owner)
    chmod 600 "$ENV_FILE"
}

cmd_start() {
    if is_running; then
        warn "Server already running on port $PORT (PID: $(server_pid))"
        dim "http://localhost:$PORT"
        exit 0
    fi

    if daemon_installed; then
        info "Starting via launchd daemon..."
        launchctl load "$PLIST_PATH" 2>/dev/null || true
        sleep 1
        if is_running; then
            info "Server started (PID: $(server_pid))"
            dim "http://localhost:$PORT"
        else
            warn "Daemon loaded but server not yet responding. Check logs:"
            dim "tail -f $SCRIPT_DIR/logs/launchd-stderr.log"
        fi
    else
        activate_venv
        info "Starting server..."
        (cd "$SCRIPT_DIR" && bash deploy.sh chat)
    fi
}

cmd_stop() {
    if daemon_installed && daemon_loaded; then
        info "Stopping via launchd daemon..."
        launchctl unload "$PLIST_PATH" 2>/dev/null || true
        sleep 1
        if ! is_running; then
            info "Stopped"
        else
            warn "Daemon unloaded but process still running. Force killing..."
            local pids
            pids=$(server_pid)
            if [ -n "$pids" ]; then
                echo "$pids" | xargs kill -9 2>/dev/null || true
            fi
            info "Stopped"
        fi
        return
    fi

    if ! is_running; then
        info "Server is not running"
        exit 0
    fi

    info "Stopping server on port $PORT..."
    local pids
    pids=$(server_pid)
    if [ -n "$pids" ]; then
        echo "$pids" | xargs kill -TERM 2>/dev/null || true
        sleep 2
        # Force kill stragglers
        pids=$(server_pid)
        if [ -n "$pids" ]; then
            echo "$pids" | xargs kill -9 2>/dev/null || true
        fi
    fi
    info "Stopped"
}

cmd_status() {
    echo ""
    echo "${BOLD}AMIGA Status${RESET}"
    echo ""

    # Daemon
    if daemon_installed; then
        if daemon_loaded; then
            echo "  Daemon:  ${GREEN}installed & loaded${RESET}"
        else
            echo "  Daemon:  ${YELLOW}installed (not loaded)${RESET}"
        fi
    else
        echo "  Daemon:  ${DIM}not installed${RESET}"
    fi

    # Server
    if is_running; then
        echo "  Server:  ${GREEN}running${RESET} (PID: $(server_pid)) on port $PORT"
    else
        echo "  Server:  ${RED}stopped${RESET}"
    fi

    # Active tasks
    if [ -f "$DB_PATH" ]; then
        local running_count
        running_count=$(sqlite3 "$DB_PATH" "SELECT COUNT(*) FROM tasks WHERE status = 'running';" 2>/dev/null || echo "?")
        local pending_count
        pending_count=$(sqlite3 "$DB_PATH" "SELECT COUNT(*) FROM tasks WHERE status = 'pending';" 2>/dev/null || echo "?")
        echo "  Tasks:   ${running_count} running, ${pending_count} pending"

        # Today's cost (from cost_tracking.json if available)
        local cost_file="$SCRIPT_DIR/data/cost_tracking.json"
        if [ -f "$cost_file" ] && command -v jq >/dev/null 2>&1; then
            local today
            today=$(date +%Y-%m-%d)
            local cost
            cost=$(jq -r ".daily[\"$today\"] // 0" "$cost_file" 2>/dev/null || echo "0")
            echo "  Cost:    \$$cost today"
        fi
    else
        echo "  Tasks:   ${DIM}no database yet${RESET}"
    fi

    echo ""
}

cmd_logs() {
    if [ ! -f "$LOG_PATH" ]; then
        err "No log file at $LOG_PATH"
        dim "Start the server first: ./amiga start"
        exit 1
    fi
    tail -f "$LOG_PATH"
}

cmd_db() {
    require_db
    if [ $# -eq 0 ]; then
        err "Usage: ./amiga db \"SQL query\""
        dim "Example: ./amiga db \"SELECT task_id, status FROM tasks ORDER BY updated_at DESC LIMIT 5;\""
        exit 1
    fi
    sqlite3 -header -column "$DB_PATH" "$1"
}

cmd_restart() {
    if daemon_installed && daemon_loaded; then
        info "Restarting via launchd..."
        launchctl kickstart -k "gui/$(id -u)/$PLIST_LABEL"
        sleep 1
        if is_running; then
            info "Server restarted (PID: $(server_pid))"
        else
            warn "Restart issued. Server may still be starting up."
            dim "tail -f $SCRIPT_DIR/logs/launchd-stderr.log"
        fi
    else
        cmd_stop
        sleep 1
        cmd_start
    fi
}

cmd_install_daemon() {
    require_macos

    if daemon_installed; then
        warn "Daemon already installed at $PLIST_PATH"
        dim "Run './amiga uninstall-daemon' first to reinstall."
        exit 1
    fi

    # Ensure log directory exists
    mkdir -p "$SCRIPT_DIR/logs"

    # Ensure venv exists
    if [ ! -d "$VENV_DIR" ]; then
        err "No venv found. Run './amiga setup' first."
        exit 1
    fi

    # Build environment dict entries from .env
    local env_entries=""
    if [ -f "$ENV_FILE" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            # Skip comments and blank lines
            [[ "$line" =~ ^[[:space:]]*# ]] && continue
            [[ -z "$line" ]] && continue
            local key="${line%%=*}"
            local value="${line#*=}"
            env_entries="${env_entries}        <key>${key}</key>
        <string>${value}</string>
"
        done < "$ENV_FILE"
    fi

    info "Creating launchd plist..."

    cat > "$PLIST_PATH" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${PLIST_LABEL}</string>

    <key>ProgramArguments</key>
    <array>
        <string>${VENV_DIR}/bin/python</string>
        <string>monitoring/server.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>${SCRIPT_DIR}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>${SCRIPT_DIR}</string>
${env_entries}    </dict>

    <key>StandardOutPath</key>
    <string>${SCRIPT_DIR}/logs/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>${SCRIPT_DIR}/logs/launchd-stderr.log</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
PLIST

    info "Loading daemon..."
    launchctl load "$PLIST_PATH"

    sleep 1
    if is_running; then
        info "Daemon installed and running (PID: $(server_pid))"
    else
        info "Daemon installed and loaded"
        dim "Server may take a moment to start."
        dim "Check: tail -f $SCRIPT_DIR/logs/launchd-stderr.log"
    fi

    dim "Plist: $PLIST_PATH"
    dim "The server will start automatically on login."
}

cmd_uninstall_daemon() {
    require_macos

    if ! daemon_installed; then
        info "Daemon is not installed"
        exit 0
    fi

    info "Unloading daemon..."
    launchctl unload "$PLIST_PATH" 2>/dev/null || true

    info "Removing plist..."
    rm -f "$PLIST_PATH"

    info "Daemon uninstalled"
}

cmd_uninstall() {
    echo ""
    warn "This will remove AMIGA from your system."
    echo ""
    echo -n "Type 'yes' to confirm: "
    read -r confirm
    if [ "$confirm" != "yes" ]; then
        info "Aborted"
        exit 0
    fi

    echo ""

    # Stop server if running
    if is_running; then
        info "Stopping server..."
        local pids
        pids=$(server_pid)
        if [ -n "$pids" ]; then
            echo "$pids" | xargs kill -TERM 2>/dev/null || true
            sleep 2
            pids=$(server_pid)
            if [ -n "$pids" ]; then
                echo "$pids" | xargs kill -9 2>/dev/null || true
            fi
        fi
        info "Server stopped"
    fi

    # Unload daemon if installed (macOS)
    if [ "$(uname)" = "Darwin" ] && daemon_installed; then
        info "Unloading daemon..."
        launchctl unload "$PLIST_PATH" 2>/dev/null || true
        rm -f "$PLIST_PATH"
        info "Daemon removed"
    fi

    # Remove symlink at /usr/local/bin/amiga if it points to this install
    local symlink="/usr/local/bin/amiga"
    if [ -L "$symlink" ]; then
        local target
        target=$(readlink "$symlink" 2>/dev/null || true)
        if [ "$target" = "$SCRIPT_DIR/amiga" ]; then
            info "Removing symlink $symlink..."
            rm -f "$symlink" 2>/dev/null || sudo rm -f "$symlink"
            info "Symlink removed"
        fi
    fi

    # Remove PATH entries from shell profiles
    local profiles=("$HOME/.zshrc" "$HOME/.bashrc")
    for profile in "${profiles[@]}"; do
        if [ -f "$profile" ]; then
            # Remove lines containing /.amiga or # AMIGA
            if grep -q -E '/\.amiga|# AMIGA' "$profile" 2>/dev/null; then
                info "Cleaning PATH entries from $(basename "$profile")..."
                sed -i.bak -E '/\/\.amiga|# AMIGA/d' "$profile"
                rm -f "$profile.bak"
            fi
        fi
    done

    echo ""
    info "AMIGA services stopped and system entries removed."
    echo ""
    dim "To remove all files: rm -rf $SCRIPT_DIR"
    echo ""
}

cmd_update() {
    step "Pulling latest changes"
    local before_hash
    before_hash=$(git -C "$SCRIPT_DIR" rev-parse HEAD)
    git -C "$SCRIPT_DIR" pull

    local after_hash
    after_hash=$(git -C "$SCRIPT_DIR" rev-parse HEAD)

    if [ "$before_hash" = "$after_hash" ]; then
        info "Already up to date"
    else
        echo ""
        info "New commits:"
        git -C "$SCRIPT_DIR" log --oneline "${before_hash}..${after_hash}"
    fi

    step "Updating dependencies"
    activate_venv
    pip install -r "$SCRIPT_DIR/requirements.txt" --quiet
    info "Dependencies updated"

    step "Rebuilding frontend"
    if [ -f "$SCRIPT_DIR/deploy.sh" ]; then
        (cd "$SCRIPT_DIR" && bash deploy.sh chat)
    else
        warn "deploy.sh not found. Skipping frontend build."
    fi

    if daemon_installed && daemon_loaded; then
        step "Restarting daemon"
        cmd_restart
    fi

    echo ""
    info "Update complete"
}

cmd_doctor() {
    echo ""
    echo "${BOLD}AMIGA Doctor${RESET}"
    echo "============"
    echo ""

    local passed=0
    local warnings=0
    local failures=0

    # Column width for aligned output
    local col=28

    doctor_ok() {
        printf "  %-${col}s ${GREEN}%-10s ok${RESET}\n" "$1" "$2"
        passed=$((passed + 1))
    }

    doctor_warn() {
        printf "  %-${col}s ${YELLOW}%-10s warning${RESET}\n" "$1" "$2"
        warnings=$((warnings + 1))
    }

    doctor_fail() {
        printf "  %-${col}s ${RED}%-10s FAIL${RESET}\n" "$1" "$2"
        failures=$((failures + 1))
    }

    # 1. Python version (>= 3.12)
    if command -v python3 >/dev/null 2>&1; then
        local py_ver
        py_ver=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}")')
        local py_major py_minor
        py_major=$(echo "$py_ver" | cut -d. -f1)
        py_minor=$(echo "$py_ver" | cut -d. -f2)
        if [ "$py_major" -ge 3 ] && [ "$py_minor" -ge 12 ]; then
            doctor_ok "Checking Python..." "$py_ver"
        else
            doctor_fail "Checking Python..." "$py_ver (<3.12)"
        fi
    else
        doctor_fail "Checking Python..." "not found"
    fi

    # 2. Node version (>= 18)
    if command -v node >/dev/null 2>&1; then
        local node_ver
        node_ver=$(node --version | sed 's/^v//')
        local node_major
        node_major=$(echo "$node_ver" | cut -d. -f1)
        if [ "$node_major" -ge 18 ]; then
            doctor_ok "Checking Node..." "$node_ver"
        else
            doctor_fail "Checking Node..." "$node_ver (<18)"
        fi
    else
        doctor_fail "Checking Node..." "not found"
    fi

    # 3. jq
    if command -v jq >/dev/null 2>&1; then
        doctor_ok "Checking jq..." "installed"
    else
        doctor_warn "Checking jq..." "not found"
    fi

    # 4. Venv
    if [ -d "$VENV_DIR" ]; then
        if [ -x "$VENV_DIR/bin/python" ]; then
            local venv_py
            venv_py=$("$VENV_DIR/bin/python" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || echo "?")
            doctor_ok "Checking venv..." "py$venv_py"
        else
            doctor_fail "Checking venv..." "broken"
        fi
    else
        doctor_fail "Checking venv..." "not found"
    fi

    # 5. Dependencies (pip check)
    if [ -x "$VENV_DIR/bin/pip" ]; then
        local pip_out
        pip_out=$("$VENV_DIR/bin/pip" check 2>&1) || true
        if echo "$pip_out" | grep -q "No broken requirements found"; then
            doctor_ok "Checking dependencies..." "clean"
        else
            local broken_count
            broken_count=$(echo "$pip_out" | grep -c "has requirement" || echo "0")
            doctor_warn "Checking dependencies..." "$broken_count broken"
        fi
    else
        doctor_warn "Checking dependencies..." "no pip"
    fi

    # 6. Environment (.env exists, keys set)
    if [ -f "$ENV_FILE" ]; then
        local env_ok=true
        local api_key_val
        api_key_val=$(grep "^ANTHROPIC_API_KEY=" "$ENV_FILE" 2>/dev/null | cut -d= -f2-)
        if [ -z "$api_key_val" ] || [ "$api_key_val" = "your_anthropic_api_key_here" ]; then
            env_ok=false
        fi
        local ws_val
        ws_val=$(grep "^WORKSPACE_PATH=" "$ENV_FILE" 2>/dev/null | cut -d= -f2-)
        if [ -z "$ws_val" ]; then
            env_ok=false
        fi
        if $env_ok; then
            doctor_ok "Checking .env..." "configured"
        else
            doctor_fail "Checking .env..." "incomplete"
        fi
    else
        doctor_fail "Checking .env..." "missing"
    fi

    # 7. .env permissions
    if [ -f "$ENV_FILE" ]; then
        local env_perms
        env_perms=$(stat -f "%Lp" "$ENV_FILE" 2>/dev/null || stat -c "%a" "$ENV_FILE" 2>/dev/null || echo "?")
        if [ "$env_perms" = "600" ]; then
            doctor_ok "Checking .env permissions..." "0600"
        else
            doctor_warn "Checking .env permissions..." "0$env_perms"
        fi
    else
        # Already reported missing above, skip
        passed=$((passed + 1))  # neutral — no file to check
        printf "  %-${col}s ${DIM}%-10s skipped${RESET}\n" "Checking .env permissions..." "no file"
    fi

    # 8. Frontend build
    if [ -d "$SCRIPT_DIR/static/chat" ] && [ "$(ls -A "$SCRIPT_DIR/static/chat/" 2>/dev/null)" ]; then
        doctor_ok "Checking frontend build..." "found"
    else
        doctor_fail "Checking frontend build..." "empty"
    fi

    # 9. Database
    if [ -f "$DB_PATH" ]; then
        if sqlite3 "$DB_PATH" "SELECT 1;" >/dev/null 2>&1; then
            doctor_ok "Checking database..." "accessible"
        else
            doctor_fail "Checking database..." "unreadable"
        fi
    else
        doctor_warn "Checking database..." "not found"
    fi

    # 10. Server health
    if is_running; then
        local health_resp
        health_resp=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:$PORT/health" 2>/dev/null || echo "000")
        if [ "$health_resp" = "200" ]; then
            doctor_ok "Checking server..." "running"
        else
            doctor_warn "Checking server..." "unhealthy"
        fi
    else
        printf "  %-${col}s ${DIM}%-10s not running${RESET}\n" "Checking server..." ""
        passed=$((passed + 1))  # neutral — not a failure if server is off
    fi

    # 11. Daemon (macOS only)
    if [ "$(uname)" = "Darwin" ]; then
        if daemon_installed; then
            if daemon_loaded; then
                doctor_ok "Checking daemon..." "loaded"
            else
                doctor_warn "Checking daemon..." "not loaded"
            fi
        else
            printf "  %-${col}s ${DIM}%-10s not installed${RESET}\n" "Checking daemon..." ""
            passed=$((passed + 1))  # neutral
        fi
    else
        printf "  %-${col}s ${DIM}%-10s n/a${RESET}\n" "Checking daemon..." ""
        passed=$((passed + 1))  # neutral
    fi

    # 12. Disk space (> 1GB free)
    local free_bytes free_gb
    if [ "$(uname)" = "Darwin" ]; then
        free_bytes=$(df -k "$SCRIPT_DIR" | tail -1 | awk '{print $4}')
        free_gb=$(( free_bytes / 1024 / 1024 ))
    else
        free_bytes=$(df -k "$SCRIPT_DIR" | tail -1 | awk '{print $4}')
        free_gb=$(( free_bytes / 1024 / 1024 ))
    fi
    if [ "$free_gb" -gt 1 ]; then
        doctor_ok "Checking disk space..." "${free_gb}GB free"
    else
        doctor_fail "Checking disk space..." "${free_gb}GB free"
    fi

    # Summary
    echo ""
    local total=$((passed + warnings + failures))
    local summary="${passed} checks passed"
    if [ "$warnings" -gt 0 ]; then
        summary="${summary}, ${YELLOW}${warnings} warning(s)${RESET}"
    fi
    if [ "$failures" -gt 0 ]; then
        summary="${summary}, ${RED}${failures} failure(s)${RESET}"
    fi
    echo "  $summary"
    echo ""

    if [ "$failures" -gt 0 ]; then
        return 1
    fi
    return 0
}

cmd_help() {
    echo ""
    echo "${BOLD}AMIGA${RESET} — Autonomous Modular Interactive Graphical Agent"
    echo ""
    echo "${BOLD}Usage:${RESET} ./amiga <command>"
    echo ""
    echo "${BOLD}Commands:${RESET}"
    echo "  ${CYAN}setup${RESET}              Interactive onboarding (venv, deps, API keys, build, daemon)"
    echo "  ${CYAN}start${RESET}              Start the monitoring server"
    echo "  ${CYAN}stop${RESET}               Stop the server"
    echo "  ${CYAN}restart${RESET}            Restart the server"
    echo "  ${CYAN}status${RESET}             Show server, daemon, tasks, and cost"
    echo "  ${CYAN}logs${RESET}               Tail the monitoring log"
    echo "  ${CYAN}update${RESET}             Pull latest, update deps, rebuild frontend"
    echo "  ${CYAN}doctor${RESET}             Check system health (Python, Node, deps, env, ...)"
    echo "  ${CYAN}db${RESET} \"<query>\"        Run a SQLite query against the task database"
    echo "  ${CYAN}install-daemon${RESET}     Install launchd daemon (macOS, start on login)"
    echo "  ${CYAN}uninstall-daemon${RESET}   Remove launchd daemon"
    echo "  ${CYAN}uninstall${RESET}          Remove AMIGA from your system (keeps files)"
    echo "  ${CYAN}help${RESET}               Show this message"
    echo ""
    echo "${BOLD}Examples:${RESET}"
    echo "  ./amiga setup"
    echo "  ./amiga start"
    echo "  ./amiga install-daemon       # Auto-start on login"
    echo "  ./amiga update               # Pull, rebuild, restart"
    echo "  ./amiga db \"SELECT task_id, status FROM tasks ORDER BY updated_at DESC LIMIT 5;\""
    echo ""
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
    setup)             cmd_setup "$@" ;;
    start)             cmd_start "$@" ;;
    stop)              cmd_stop "$@" ;;
    restart)           cmd_restart "$@" ;;
    status)            cmd_status "$@" ;;
    logs)              cmd_logs "$@" ;;
    update)            cmd_update "$@" ;;
    doctor)            cmd_doctor "$@" ;;
    db)                cmd_db "$@" ;;
    install-daemon)    cmd_install_daemon "$@" ;;
    uninstall-daemon)  cmd_uninstall_daemon "$@" ;;
    uninstall)         cmd_uninstall "$@" ;;
    help|-h|--help)    cmd_help ;;
    *)
        err "Unknown command: $COMMAND"
        cmd_help
        exit 1
        ;;
esac
